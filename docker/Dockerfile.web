# Build stage
FROM node:22-alpine AS build
WORKDIR /app

COPY src/sentinel-web/package.json src/sentinel-web/package-lock.json* ./
RUN npm ci || npm install

COPY src/sentinel-web/ ./
RUN npm run build

# Runtime stage
FROM nginx:1.27-alpine AS runtime

RUN addgroup -g 1001 -S sentinel \
    && adduser -u 1001 -S sentinel -G sentinel \
    && chown -R sentinel:sentinel /var/cache/nginx /var/log/nginx \
    && touch /var/run/nginx.pid \
    && chown sentinel:sentinel /var/run/nginx.pid

COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/dist /usr/share/nginx/html

USER sentinel
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:8080/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
