# Sentinel Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Application
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5018
WEB_PORT=3000

# PostgreSQL
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_dev_password
POSTGRES_PORT=5432

# ClickHouse
CLICKHOUSE_DB=sentinel
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=sentinel
RABBITMQ_PASSWORD=sentinel_dev_password
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# JWT (change in production!)
JWT_SECRET_KEY=sentinel-dev-secret-key-change-in-production-min-32-chars
