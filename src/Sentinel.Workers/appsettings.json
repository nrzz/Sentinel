{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Sentinel": {
    "ServiceName": "sentinel-workers",
    "Environment": "development"
  },
  "PostgreSQL": {
    "ConnectionString": "Host=localhost;Port=5432;Database=sentinel;Username=sentinel;Password=sentinel_dev_password"
  },
  "ClickHouse": {
    "ConnectionString": "Host=localhost;Port=8123;Database=sentinel;Username=default;Password="
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "RabbitMQ": {
    "ConnectionString": "amqp://sentinel:sentinel_dev_password@localhost:5672"
  },
  "AlertEvaluation": {
    "ErrorLogThresholdPerMinute": 100,
    "Rules": [
      {
        "Name": "high-cpu",
        "MetricName": "cpu.usage",
        "Threshold": 90,
        "Operator": "GreaterThan",
        "Severity": "warning"
      },
      {
        "Name": "high-error-rate",
        "MetricName": "error.rate",
        "Threshold": 50,
        "Operator": "GreaterThan",
        "Severity": "critical"
      }
    ]
  }
}
